<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <View
        android:id="@+id/streakBg"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_streak_day"
        android:visibility="gone" />

    <View
        android:id="@+id/selectedBg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_selected_day"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center"
        android:text="1"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#111111" />

    <TextView
        android:id="@+id/tvFire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="6dp"
        android:text="🔥"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:id="@+id/viewDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_status_circle" />
</FrameLayout>